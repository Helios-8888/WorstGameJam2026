  m_Script: {fileID: 11500000, guid: 1d5d27926bb93624ea0e682a8a6929d4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textComponent: {fileID: 8714159883619118850}
  lines:
  - Hi dear, I want you to build a computer for me. :)
  - 'Try put the CPU in right place '
  - 'How about you now try put the RAM in the right position '
  - 'Next try put the SSD in the right place and screw it in '
  - 'Now put a small amount of Thermal Paste. '
  - 'Have a go at putting the GPU in the right position '
  - 'Put the power supply where it belongs '
  - "Why don\u2019t you try placing the Wi-Fi in its slot "
  - 'Now screw the Fans where it should be  '
  textSpeed: 0.05
  next: {fileID: 7476244043514120974, guid: 2bcd2660ca9b64942af0de543d8d7100, type: 3}
