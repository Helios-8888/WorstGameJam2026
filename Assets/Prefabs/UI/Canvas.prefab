    - target: {fileID: 3703295643087900191, guid: 70eb4b6ffc2379148b5d82d608995670, type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: 'Try put the CPU in right place '
      objectReference: {fileID: 0}
    - target: {fileID: 3703295643087900191, guid: 70eb4b6ffc2379148b5d82d608995670, type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: 'How about you now try put the RAM in the right position '
      objectReference: {fileID: 0}
    - target: {fileID: 3703295643087900191, guid: 70eb4b6ffc2379148b5d82d608995670, type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: 'Next try put the SSD in the right place and screw it in '
